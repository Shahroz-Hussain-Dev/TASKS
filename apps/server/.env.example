# ───────────── Raahi server — environment ─────────────
# Postgres (Supabase). Either the direct URL (auto-rewritten to the IPv4 pooler)
# or the pooler URL. Percent-encode special characters in the password (@ → %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# 32+ random characters. Generate: openssl rand -base64 48
JWT_SECRET=

# Google Gemini (Developer API key) — document verification & support chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# First admin account (created on first boot if no admin exists)
ADMIN_EMAIL=admin@raahi.pk
ADMIN_PASSWORD=
ADMIN_NAME=Raahi Admin

# Optional: Supabase Storage for images (otherwise stored in Postgres)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=raahi-files

# Optional overrides
# OSRM_URL=https://router.project-osrm.org
# PHOTON_URL=https://photon.komoot.io
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# APP_PUBLIC_URL=https://your-deployment.vercel.app
# CORS_ORIGINS=
# AUTO_MIGRATE=true
