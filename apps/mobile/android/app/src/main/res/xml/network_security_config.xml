<?xml version="1.0" encoding="utf-8"?>
<!-- Raahi only talks to HTTPS endpoints (the API on Vercel, map tiles, geocoding). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
