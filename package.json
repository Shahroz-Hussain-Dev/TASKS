{
  "name": "raahi",
  "version": "1.0.0",
  "private": true,
  "description": "Raahi \u2014 fair-price ride hailing for Pakistan. Passengers name their fare, drivers bid, everyone wins.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:server": "pnpm --filter @raahi/server dev",
    "dev:mobile": "pnpm --filter @raahi/mobile dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @raahi/server db:generate",
    "db:migrate": "pnpm --filter @raahi/server db:migrate",
    "android:build": "pnpm --filter @raahi/mobile android:release",
    "laptop": "pnpm --filter @raahi/server laptop",
    "laptop:dev": "pnpm --filter @raahi/server laptop:dev"
  }
}
